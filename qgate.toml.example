# qgate.toml: the one config file for the local quality gate.
# Loosening anything here (raising a limit, removing a tool, excluding paths)
# is allowed, and each loosening shows as a warning in the run output.

# The qgate version the baseline was measured with. A different binary refuses
# to run and prints the install command for this version.
qgate_version = "0.4.1"

# Extra globs excluded from the built-in checks. Binary files, lockfiles,
# *.min.*, vendor/, node_modules/, dist/, files marked linguist-generated or
# linguist-vendored in .gitattributes, and Go files with a
# `// Code generated ... DO NOT EDIT.` header are always excluded.
exclude = ["testdata/**"]

# Test data such as goldens. Files here skip the built-in checks, and adding new
# ones is not a loosening. Source files qgate parses for functions (.c, .py,
# .rs, ...) are still checked like any other code.
fixtures = ["tests/golden/**"]

# C/C++ macros blanked before parsing, so attributes such as MUST_USE don't
# cause syntax errors. Line numbers are unchanged.
attribute_macros = ["MUST_USE"]

# Extra inline-ignore markers to warn about, on top of the built-in table
# (eslint-disable, @ts-ignore, # noqa, #[allow], //nolint, ...).
ignore_patterns = ["@custom-suppress"]

[limits]
function_lines = 50   # physical lines from a function's first line to its last
file_lines = 500

[ratchet]
headroom_lines = 0    # lines a baselined function or file may grow past its recorded size

[duplication]
enabled = true
min_tokens = 50       # shortest copied block that counts, in tokens

[tasks]
# Matches one task ID, such as QG-31, in branch names and commit messages.
# A new feature in qgate.features.toml must name a task this pattern matches.
pattern = '\b[A-Z][A-Z0-9]+-[0-9]+\b'

# The repo's own tools. `{files}` receives the staged files matching `globs`;
# a command without it runs once on the whole project.
[[tool]]
name = "eslint"
command = "npx eslint --format json {files}"
globs = ["**/*.{js,jsx,ts,tsx}"]
stage = "commit"
config_files = ["eslint.config.js", ".eslintrc.json"]
format = "eslint-json"   # auto | sarif | eslint-json | mix | gcc | text

[[tool]]
name = "tests"
command = "npm test"
stage = "push"           # push-stage tools never run at commit
timeout_secs = 900

# A check that signals only by exit code (`test -z`, `grep -q`, `diff -q`)
# fails with nothing to show. Print what it found before testing it:
# [[tool]]
# name = "gofmt"
# command = 'out=$(gofmt -l {files}); echo "$out"; test -z "$out"'
# globs = ["**/*.go"]
# format = "text"

# Elixir: `format = "mix"` reads compile diagnostics, ExUnit failures and
# `mix format --check-formatted`. Credo reports through SARIF.
# [[tool]]
# name = "mix-test"
# command = "mix test"
# stage = "push"
# format = "mix"
#
# [[tool]]
# name = "credo"
# command = "mix credo --strict --format sarif"
# config_files = [".credo.exs"]
# format = "sarif"

# Per-directory limit overrides for monorepos.
[[package]]
path = "services/legacy"
function_lines = 80

# Or per glob. A matching glob wins over directories; the last matching glob wins.
[[package]]
glob = "tests/**"
file_lines = 3000
